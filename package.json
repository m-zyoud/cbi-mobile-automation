{
  "name": "cbi-mobile-automation",
  "version": "1.0.0",
  "description": "Reusable Playwright automation framework for CBI mobile web testing on real Android Chrome using ADB and CDP.",
  "main": "index.js",
  "scripts": {
  "typecheck": "tsc --noEmit",
  "test:list": "playwright test --list",
  "test": "playwright test --workers=1",

  "test:smoke": "playwright test --grep @smoke --workers=1",
  "test:regression": "playwright test --grep @regression --workers=1",

  "test:e2e": "playwright test tests/journeys/purchase-flow.e2e.spec.ts --workers=1",

  "test:frontgate": "playwright test --grep \"Frontgate\" --workers=1",
  "test:ballard": "playwright test --grep \"Ballard Designs\" --workers=1",
  "test:garnet": "playwright test --grep \"Garnet Hill\" --workers=1",
  "test:grandin": "playwright test --grep \"Grandin Road\" --workers=1",

  "report": "playwright show-report"
},
  "keywords": [
    "playwright",
    "qa",
    "automation",
    "android",
    "mobile-testing",
    "typescript"
  ],
  "author": "Mohammad Zyoud",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2"
  }
}